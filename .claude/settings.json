{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "ctxloom tasks stamp-plan",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/bin/ltk evaluate --config .ltk/config.yaml",
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ctxloom session bind",
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "ctxloom meta hud",
    "type": "command"
  }
}
