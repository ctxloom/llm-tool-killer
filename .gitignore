# Build artifacts
/bin/
/dist/
*.test
*.out
coverage.*

# ltk "confirm by repeating" override state (runtime, regenerable)
.ltk/state.json

# OS / editor
.DS_Store

# Tooling backups (e.g. ctxloom *.ctxloom.bak)
*.ctxloom.bak

# ctxloom ephemeral data + cached remote clones (regenerable, embedded repos)
.ctxloom/ephemeral/
.ctxloom/cache/

# ctxloom private project identity (working state, never distributed)
.ctxloom/project-id

# Claude Code harness runtime state (scheduled-task lock, etc.)
.claude/scheduled_tasks.lock

# ltk manage install settings backups
*.ltk.bak
