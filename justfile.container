# Container justfile for ltk (llm-tool-killer) — runs INSIDE the devcontainer,
# where the pinned tools live (golangci-lint v2, gremlins). Overlaid as the
# in-container justfile by `just _run`, and invoked directly in CI via
# `just -f justfile.container <target>`.
#
# Module mode: deps resolve from go.mod pins (cache/proxy), never a host go.work.
export GOWORK := "off"

# Default recipe.
default: check

# Run all tests under -race (includes the godog acceptance suite).
test *ARGS:
    go test -race {{ARGS}} ./...

# Vet all packages.
vet:
    go vet ./...

# Report any unformatted files.
fmt-check:
    @test -z "$(gofmt -l .)" || { echo "unformatted:"; gofmt -l .; exit 1; }

# golangci-lint (v2; config in .golangci.yml).
lint:
    golangci-lint run

# Fail if the shipped default rules are out of sync with docs/DEFAULTS.md.
defaults-check:
    go run ./tools/extract-defaults -check

# Mutation testing (gremlins; config in .gremlins.yaml).
test-mutation *ARGS:
    gremlins unleash {{ARGS}}

# Full gate: format check, vet, lint, defaults sync, tests.
check: fmt-check vet lint defaults-check test
